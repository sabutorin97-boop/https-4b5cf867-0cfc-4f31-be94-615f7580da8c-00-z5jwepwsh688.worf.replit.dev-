# ============================================================
#  Переменные окружения. Скопировать в .env и заполнить.
#  .env в репозиторий не коммитится.
#  Версия 2 — новые переменные помечены [v2].
# ============================================================

# ---------- Публичные адреса ----------
PUBLIC_SITE_URL=https://example.ru
PUBLIC_APP_URL=https://app.example.ru
# [v2] Домены без схемы — для Caddyfile
PUBLIC_SITE_HOST=example.ru
PUBLIC_APP_HOST=app.example.ru
ACME_EMAIL=admin@example.ru

# ---------- Базы данных ----------
# [v2] Отдельные роли: роль генераций не имеет прав на базу биллинга.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
BILLING_DB_PASSWORD=
GENERATION_DB_PASSWORD=
BILLING_DATABASE_URL=postgresql://billing_app:BILLING_DB_PASSWORD@postgres:5432/billing?schema=public
GENERATION_DATABASE_URL=postgresql://generation_app:GENERATION_DB_PASSWORD@postgres:5432/generation?schema=public

# ---------- Межсервисная авторизация ----------
# Токен для внутреннего API биллинга и секрет для HMAC-подписи тела запроса.
# Генерировать: openssl rand -hex 32
SERVICE_TOKEN=
SERVICE_HMAC_SECRET=
# [v2] Второй активный токен на время ротации — ротация без простоя
SERVICE_TOKEN_PREVIOUS=
# [v2] Окно проверки метки времени подписи, защита от повторов
SERVICE_SIGNATURE_WINDOW_SEC=300

# ---------- JWT для SSO между кассой и кабинетом ----------
# [v2] base64, чтобы многострочный PEM не ломал парсинг .env
#   openssl genrsa -out jwt.key 2048 && openssl rsa -in jwt.key -pubout -out jwt.pub
#   base64 -w0 jwt.key > jwt.key.b64
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

# ---------- Egress ----------
# Используется ТОЛЬКО адаптерами провайдеров через packages/shared/http.
# setGlobalDispatcher запрещён линтером и рантайм-стражем.
EGRESS_PROXY_URL=http://egress:8888
# [v2] MTU: без явного значения часть TLS-соединений виснет
EGRESS_WG_MTU=1380

# ---------- Провайдеры генерации ----------
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

GENAPI_API_KEY=
GENAPI_BASE_URL=https://api.gen-api.ru

PROVIDER_BALANCE_WARN_USD=50
PROVIDER_BALANCE_STOP_USD=10

# [v2] Секрет для подписи URL колбэков провайдера.
# Без него любой мог прислать {"status":"success"} и получить коммит холда.
CALLBACK_SECRET=

# ---------- Платежи ----------
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_ALLOWED_IPS=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.156.11,77.75.156.35,77.75.154.128/25,2a02:5180::/32

TBANK_TERMINAL_KEY=
TBANK_PASSWORD=

# [v2] 54-ФЗ: состав чека передаётся в кассу при создании платежа
RECEIPT_VAT_CODE=1
RECEIPT_PAYMENT_SUBJECT=service
RECEIPT_PAYMENT_MODE=full_prepayment
RECEIPT_COMPANY_EMAIL=

# ---------- Хранилище S3 ----------
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SIGNED_URL_TTL_SEC=3600

# ---------- Бэкапы [v2] ----------
# Дамп биллинга уезжает к ДРУГОМУ провайдеру: отказ основного аккаунта
# не должен уносить историю платежей.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Отдельный бот для алертов владельцу
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# ---------- Капча [v2] ----------
# Гостевая квота по отпечатку браузера обходится инкогнито-окном.
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=

# ---------- Экономика ----------
FX_USD_RUB_FALLBACK=85
FX_RATE_SOURCE=cbr
# Запас на движение курса, закладывается в цену кредита
FX_SAFETY_MARGIN_PERCENT=15

# ---------- Лимиты ----------
GUEST_FREE_GENERATIONS=2
FREE_PLAN_WELCOME_CREDITS=10
# [v2] TTL холда — нижняя граница. Фактический считается по модели:
# model.timeoutSec * (maxAttempts + 1) + 300. Фиксированные 900 секунд
# короче таймаута видеомоделей — коммит приходил бы на просроченный холд.
HOLD_TTL_MIN_SEC=900
# [v2] Поллинг с бэкоффом вместо фиксированного интервала для всех задач
GENERATION_POLL_BACKOFF_SEC=5,10,20,40,60
MAX_UPLOAD_SIZE_MB=15
# [v2] Лимит пикселей — защита от «архивных бомб», байтов недостаточно
MAX_UPLOAD_PIXELS=50000000
FREE_TIER_STORAGE_DAYS=7
# [v2] Грейс-период при понижении тарифа, чтобы архив не удалился разом
DOWNGRADE_GRACE_DAYS=30

# ---------- Защита бюджета [v2] ----------
# Стоп-кран. Одна ошибка в цикле может израсходовать предоплату за ночь.
GLOBAL_DAILY_BUDGET_USD=50
GUEST_DAILY_BUDGET_USD=5
GOODWILL_REROLL_WINDOW_SEC=600
GOODWILL_REROLLS_PER_DAY=3

# ---------- Реферальная программа [v2] ----------
# Пользователь приводит пользователя, вознаграждение КРЕДИТАМИ
REFERRAL_PERCENT=15
REFERRAL_MONTHLY_CAP_CREDITS=3000
# Задержка начисления — окно чарджбэка
REFERRAL_HOLD_HOURS=72

# ---------- Партнёрская программа [v2] ----------
# Внешний партнёр приводит клиентов, вознаграждение ДЕНЬГАМИ (docs/09-partners.md)
PARTNER_PERCENT_BASE=20
PARTNER_PERCENT_ADVANCED=25
PARTNER_PERCENT_STRATEGIC=30
# Порог перехода на уровень — по ПОДТВЕРЖДЁННЫМ платящим клиентам
PARTNER_TIER_ADVANCED_CLIENTS=50
PARTNER_TIER_STRATEGIC_CLIENTS=200
# Окно возврата и оспаривания платежа: до его истечения комиссия не выплачивается
PARTNER_COMMISSION_HOLD_DAYS=14
# Порог выплаты в копейках: перевод на 300 ₽ дороже в сопровождении, чем сам перевод
PARTNER_PAYOUT_MIN_KOPECKS=500000
PARTNER_PAYOUT_DAY_OF_MONTH=10
# Атрибуция: окно ссылки до регистрации и срок закрепления клиента за партнёром
PARTNER_LINK_WINDOW_DAYS=30
PARTNER_ATTRIBUTION_MONTHS=12
# Бонус клиенту по промокоду, только на первую покупку
PROMO_BONUS_PERCENT=10
# Минимальная доля повторных покупок, ниже которой ставка партнёра режется
PARTNER_MIN_REPEAT_RATE_PERCENT=5

# ---------- Наблюдаемость [v2] ----------
SENTRY_DSN=
GRAFANA_PASSWORD=

# ---------- Прочее ----------
NODE_ENV=production
LOG_LEVEL=info
TZ=Europe/Moscow
